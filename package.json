{
  "name": "aetheris-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:public && npm run build:admin",
    "typecheck": "tsc -b && tsc -p admin/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "worker:check": "tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "build:public": "tsc -p tsconfig.public.json && vite build && node scripts/check-public-build.mjs",
    "build:admin": "tsc -p admin/tsconfig.json && vite build admin --config admin/vite.config.ts",
    "test:public-build": "npm run build:public"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@mui/stylis-plugin-rtl": "^9.5.0",
    "@tanstack/react-query": "^5.90.10",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "stylis": "^4.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2",
    "vitest": "^4.0.13",
    "wrangler": "^4.50.0"
  }
}
